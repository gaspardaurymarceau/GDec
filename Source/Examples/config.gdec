:RECIPE

# Refining

REFINED_DIAMOND=2*ENCHANTED_DIAMOND_BLOCK
REFINED_MITHRIL=160*ENCHANTED_MITHRIL
REFINED_TITANIUM=16*ENCHANTED_TITANIUM
REFINED_TUNGSTEN=160*ENCHANTED_TUNGSTEN
REFINED_UMBER=160*ENCHANTED_UMBER


# Forging

BEJEWELED_HANDLE=3*GLACITE_JEWEL
DRILL_ENGINE=10*TREASURITE+ENCHANTED_IRON_BLOCK+3*ENCHANTED_REDSTONE_BLOCK+GOLDEN_PLATE
FUEL_TANK=2*ENCHANTED_COAL_BLOCK
GEMSTONE_MIXTURE=320*SLUDGE_JUICE+4*FINE_JADE_GEM+4*FINE_AMBER_GEM+4*FINE_AMETHYST_GEM+4*FINE_SAPPHIRE_GEM
GLACITE_AMALGAMATION=256*ENCHANTED_GLACITE+4*FINE_ONYX_GEM+4*FINE_CITRINT_GEM+4*FINE_PERIDOT_GEM+4*FINE_GLACITE_GEM
GOLDEN_PLATE=REFINED_DIAMOND+2*ENCHANTED_GOLD_BLOCK+5*GLACITE_JEWEL
MITHRIL_PLATE=GOLDEN_PLATE+ENCHANTED_IRON_BLOCK+REFINED_TITANIUM+5*REFINED_MITHRIL
TUNGSTEN_PLATE=GLACITE_AMALGAMATION+4*REFINED_TUNGSTEN
UMBER_PLATE=GLACITE_AMALGAMATION+4*REFINED_UMBER
PERFECT_PLATE=MITHRIL_PLATE+UMBER_PLATE+TUNGSTEN_PLATE


# Tools

MITHRIL_DRILL_1=3*REFINED_MITHRIL+FUEL_TANK+DRILL_ENGINE
MITHRIL_DRILL_2=MITHRIL_DRILL_1+GOLDEN_PLATE+MITHRIL_PLATE
GEMSTONE_DRILL_1=6*FINE_RUBY_GEM+FUEL_TANK+DRILL_ENGINE
GEMSTONE_DRILL_2=GEMSTONE_DRILL_1+3*GEMSTONE_MIXTURE
GEMSTONE_DRILL_3=GEMSTONE_DRILL_2+3*GEMSTONE_MIXTURE+FLAWLESS_TOPAZ_GEM+8*MAGMA_CORE
GEMSTONE_DRILL_4=GEMSTONE_DRILL_3+FLAWLESS_JASPER_GEM+100*TREASURITE+16*MAGMA_CORE
TITANIUM_DRILL_1=8*REFINED_TITANIUM+8*REFINED_MITHRIL+DRILL_ENGINE+FUEL_TANK+6*GOLDEN_PLATE
TITANIUM_DRILL_2=TITANIUM_DRILL_1+10*REFINED_DIAMOND+12*REFINED_TITANIUM+5*MITHRIL_PLATE
TITANIUM_DRILL_3=TITANIUM_DRILL_2+20*REFINED_DIAMOND+16*REFINED_TITANIUM+2*ENCHANTED_IRON_BLOCK+10*MITHRIL_PLATE+20*PLASMA
TITANIUM_DRILL_4=TITANIUM_DRILL_3+FLAWLESS_RUBY_GEM+30*CORLEONITE+5*REFINED_DIAMOND+32*REFINED_TITANIUM+16*GEMSTONE_MIXTURE+10*MITHRIL_PLATE
DIVAN_DRILL=TITANIUM_DRILL_4+DIVAN_ALLOY+50000000*COIN
POLISHED_TOPAZ_ROD=3*BEJEWELED_HANDLE+2*FLAWLESS_TOPAZ_GEM
CHISEL=BEJEWELED_HANDLE+64*TUNGSTEN
REINFORCED_CHISEL=CHISEL+BEJEWELED_HANDLE+2*REFINED_TUNGSTEN+2*REFINED_UMBER
GLACITE_CHISEL=REINFORCED_CHISEL+BEJEWELED_HANDLE+MITHRIL_PLATE+GLACITE_AMALGAMATION
PERFECT_CHISEL=GLACITE_CHISEL+BEJEWELED_HANDLE+PERFECT_PLATE


# Gear

MITHRIL_NECKLACE=3*ENCHANTED_MITHRIL
MITHRIL_CLOAK=3*ENCHANTED_MITHRIL
MITHRIL_BELT=3*ENCHANTED_MITHRIL
MITHRIL_GAUNTLET=3*ENCHANTED_MITHRIL
TITANIUM_NECKLACE=MITHRIL_NECKLACE+16*REFINED_MINERAL+REFINED_TITANIUM
TITANIUM_CLOAK=MITHRIL_CLOAK+16*REFINED_MINERAL+REFINED_TITANIUM
TITANIUM_BELT=MITHRIL_BELT+16*REFINED_MINERAL+REFINED_TITANIUM
TITANIUM_GAUNTLET=MITHRIL_GAUNTLET+16*REFINED_MINERAL+REFINED_TITANIUM
TITANIUM_TALISMAN=2*REFINED_TITANIUM
TITANIUM_RING=TITANIUM_TALISMAN+6*REFINED_TITANIUM
TITANIUM_ARTIFACT=TITANIUM_RING+12*REFINED_TITANIUM
TITANIUM_RELIC=TITANIUM_ARTIFACT+20*REFINED_TITANIUM
DIVAN_POWDER_COATING=32*REFINED_MINERAL+32*GLOSSY_GEMSTONE+16*ENCHANTED_GOLD_BLOCK+5*DIVAN_FRAGMENT
DIVAN_HELMET=FLAWLESS_RUBY_GEM+10*GEMSTONE_MIXTURE+5*DIVAN_FRAGMENT
DIVAN_CHESTPLATE=FLAWLESS_RUBY_GEM+10*GEMSTONE_MIXTURE+8*DIVAN_FRAGMENT
DIVAN_LEGGINGS=FLAWLESS_RUBY_GEM+10*GEMSTONE_MIXTURE+7*DIVAN_FRAGMENT
DIVAN_BOOTS=FLAWLESS_RUBY_GEM+10*GEMSTONE_MIXTURE+4*DIVAN_FRAGMENT
AMBER_NECKLACE=32*GLOSSY_GEMSTONE+2*FLAWLESS_AMBER_GEM
SAPPHIRE_CLOAK=32*GLOSSY_GEMSTONE+2*FLAWLESS_SAPPHIRE_GEM
JADE_BELT=32*GLOSSY_GEMSTONE+2*FLAWLESS_JADE_GEM
AMETHYSH_GAUNTLET=32*GLOSSY_GEMSTONE+2*FLAWLESS_AMETHYST_GEM
GEMSTONE_CHAMBER=25000*COIN+GEMSTONE_MIXTURE+100*WORM_MEMBRANE
DWARVEN_HANDWARMERS=FLAWLESS_JADE_GEM+FLAWLESS_AMBER_GEM+TUNGSTEN_PLATE+UMBER_PLATE
DWARVEN_METAL_TALISMAN=4*REFINED_UMBER+4*REFINED_TUNGSTEN+4*GLACITE_AMALGAMATION
DIVAN_PENDANT=SHATTERED_PENDANT+10*DIVAN_FRAGMENT+PERFECT_PLATE
POWER_RELIC=POWER_ARTIFACT+PERFECT_PLATE+32*GLACITE_AMALGAMATION


# Reforge Stones

DIAMONITE=3*REFINED_DIAMOND
POCKET_ICEBERG=5*GLACITE_JEWEL
PETRIFIED_STARFALL=512*STARFALL
PURE_MITHRIL=2*REFINED_MITHRIL
ROCK_GEMSTONE=64*TREASURITE+128*ENCHANTED_COBBLESTONE
TITANIUM_TESSERACT=REFINED_TITANIUM+16*ENCHANTED_LAPIS_LAZULI
GLEAMING_CRYSTAL=32*GLOSSY_GEMSTONE+REFINED_MITHRIL+2*REFINED_DIAMOND
HOT_STUFF=128*ENCHANTED_HARD_STONE+FLAWLESS_TOPAZ_GEM
AMBER_MATERIAL=12*FINE_AMBER_GEM+GOLDEN_PLATE
FRIGID_HUSK=FLAWLESS_ONYX_GEM+4*GLACITE_AMALGAMATION


# Drill Parts

STARFALL_SEASONING=16*TREASURITE+64*STARFALL
GOBLIN_OMELETTE=96*GOBLIN_EGG
GOBLIN_OMELETTE_BLUE_CHEESE=GOBLIN_OMELETTE+96*GOBLIN_EGG_BLUE+FLAWLESS_SAPPHIRE_GEM
GOBLIN_OMELETTE_PESTO=GOBLIN_OMELETTE+96*GOBLIN_EGG_GREEN+FLAWLESS_JADE_GEM
GOBLIN_OMELETTE_SPICY=GOBLIN_OMELETTE+96*GOBLIN_EGG_RED+FLAWLESS_RUBY_GEM
GOBLIN_OMELETTE_SUNNY_SIDE=GOBLIN_OMELETTE+96*GOBLIN_EGG_YELLOW+FLAWLESS_TOPAZ_GEM
TUNGSTEN_KEYCHAIN=PERFECT_OPAL_GEM+5*FUEL_TANK+5*TUNGSTEN_PLATE
MITHRIL_DRILL_ENGINE=2*DRILL_ENGINE+MITHRIL_PLATE
TITANIUM_DRILL_ENGINE=MITHRIL_DRILL_ENGINE+2*DRILL_ENGINE+8*REFINED_TITANIUM
RUBY_POLISTED_DRILL_ENGINE=TITANIUM_DRILL_ENGINE+PERFECT_RUBY_GEM+4*PRECURSOR_APPARATUS+5*DRILL_ENGINE
SAPPHIRE_POLISHED_DRILL_ENGINE=3*PERFECT_SAPPHIRE_GEM+8*PRECURSOR_APPARATUS+5*DRILL_ENGINE+16*PLASMA
AMBER_POLISHED_DRILL_ENGINE=SAPPHIRE_POLISHED_DRILL_ENGINE+5*PERFECT_AMBER_GEM+5*DRILL_ENGINE+16*PRECURSOR_APPARATUS+32*PLASMA
MITHRIL_FUEL_TANK=5*REFINED_DIAMOND+10*REFINED_MITHRIL+5*FUEL_TANK
TITANIUM_FUEL_TANK=MITHRIL_FUEL_TANK+10*REFINED_TITANIUM+5*REFINED_DIAMOND+5*FUEL_TANK
GEMSTONE_FUEL_TANK=TITANIUM_FUEL_TANK+4*PRECURSOR_APPARATUS+10*GEMSTONE_MIXTURE
PERFECTLY_CUR_FUEL_TANK=GEMSTONE_FUEL_TANK+16*PRECURSOR_APPARATUS+25*GEMSTONE_MIXTURE+32*PLASMA


# Perfect Gemstones

PERFECT_AMBER_GEM=5*FLAWLESS_AMBER_GEM+AMBER_CRYSTAL
PERFECT_AMETHIST_GEM=5*FLAWLESS_AMETHIST_GEM+AMETHIST_CRYSTAL
PERFECT_JADE_GEM=5*FLAWLESS_JADE_GEM+JADE_CRYSTAL
PERFECT_JASPER_GEM=5*FLAWLESS_JASPER_GEM+JASPER_CRYSTAL
PERFECT_OPAL_GEM=5*FLAWLESS_OPAL_GEM+OPAL_CRYSTAL
PERFECT_RUBY_GEM=5*FLAWLESS_RUBY_GEM+RUBY_CRYSTAL
PERFECT_SAPPHIRE_GEM=5*FLAWLESS_SAPPHIRE_GEM+SAPPHIRE_CRYSTAL
PERFECT_TOPAZ_GEM=5*FLAWLESS_TOPAZ_GEM+TOPAZ_CRYSTAL
PERFECT_AQUAMARINE_GEM=5*FLAWLESS_AQUAMARINE_GEM+AQUAMARINE_CRYSTAL
PERFECT_CITRINE_GEM=5*FLAWLESS_CITRINE_GEM+CITRINE_CRYSTAL
PERFECT_ONYX_GEM=5*FLAWLESS_ONYX_GEM+ONYX_CRYSTAL
PERFECT_PERIDOT_GEM=5*FLAWLESS_PERIDOT_GEM+PERIDOT_CRYSTAL


# Pets

BEJEWELED_COLLAR=*REFINED_MITHRIL+BEJEWELED_HANDLE
PET_MOLE=CLAW_FOSSIL+300000*COIN
PET_AMMONITE=HELIX_FOSSILE+300000*COIN
PET_PENGUIN=WEBBED_FOSSIL+FLAWLESS_AQUAMARINE_GEM
PET_T_REX=FOOTPRINT_FOSSIL+FLAWLESS_ONYX_GEM
PET_SPINOSAURUS=SPINE_FOSSIL+FLAWLESS_AQUAMARINE_GEM
PET_GOBLIN=UGLY_FOSSIL+FLAWLESS_AMBER_GEM
PET_ANKYLOSAURUS=CLUBBED_FOSSIL+FLAWLESS_OPAL_GEM
PET_MAMMOTH=TUSK_FOSSIL+FLAWLESS_ONYX_GEM


# Other

BEACON_2=BEACON_1+5*REFINED_MITHRIL
BEACON_3=BEACON_2+10*REFINED_MITHRIL
BEACON_4=BEACON_3+20*REFINED_MITHRIL+PLASMA
BEACON_5=BEACON_4+40*REFINED_MITHRIL+5*PLASMA
FORGE_TRAVEL_SCROLL=_80*TITANIUM+16*ENCHANTED_ENDER_PEARL+48*MITHRIL+25000*COIN
BASE_CAMP_TRAVEL_SCROLL=FLAWLESS_ONYX_GEM+16*ENCHANTED_ENDER_PEARL+500000*COIN
POWER_CRYSTAL=256*STARFALL
SECRET_RAILROAD_PASS=FLAWLESS_RUBY_GEMSTONE+2*REFINED_MITHRIL+8*CORLEONITE
TUNGSTEN_KEY=192*ENCHANTED_TUNGSTEN+BEJEWELED_HANDLE
UMBER_KEY=192*ENCHANTED_UMBER+BEJEWELED_HANDLE
SKELETON_KEY=PERFECT_PLATE+BEJEWELED_HANDLE
PORTABLE_CAMPFIRE=REFINED_UMBER+16*MATCH_STICKS
